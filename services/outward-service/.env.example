OUTWARD_SERVICE_PORT=8087
MONGODB_BASE_URI=mongodb://localhost:27017
MONGODB_DATABASE=outward
MONGODB_AUTO_INDEX_CREATION=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRACING_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

MASTER_DATA_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8086
MASTER_DATA_CONNECT_TIMEOUT_MS=2000
MASTER_DATA_READ_TIMEOUT_MS=3000

# Must match auth-service JWT configuration exactly.
JWT_ISSUER=auth-service
JWT_SECRET_KEY=<same-256-bit-secret-used-by-auth-service>
OUTWARD_APPROVAL_ROLES=TL,MD
OUTWARD_ISSUE_ROLES=WAREHOUSE,INVENTORY_OPERATOR,TL,MD
CORRELATION_HEADER=X-Correlation-Id

OUTWARD_ISSUED_TOPIC=outward.events
STOCK_ISSUE_APPROVED_TOPIC=inventory.events
AUDIT_EVENTS_TOPIC=audit.events
NOTIFICATION_EVENTS_TOPIC=notification.events
OUTBOX_PUBLISHER_FIXED_DELAY_MS=1000
OUTBOX_PUBLISHER_SEND_TIMEOUT_MS=5000
OUTBOX_PUBLISHER_MAX_ATTEMPTS=10

# Observability
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4317
OTEL_METRICS_EXPORT_ENABLED=true
OTEL_METRICS_EXPORT_STEP=30s
