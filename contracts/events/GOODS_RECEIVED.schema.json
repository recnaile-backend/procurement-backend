{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GOODS_RECEIVED",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "traceId",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "GOODS_RECEIVED" },
    "eventVersion": { "type": "integer", "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "inward-service" },
    "correlationId": { "type": ["string", "null"] },
    "traceId": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grnId",
        "poId",
        "itemName",
        "orderedQuantity",
        "acceptedQuantity",
        "rejectedQuantity",
        "unitOfMeasure",
        "rejectionReason",
        "deliveryNoteNumber",
        "deliveryDate",
        "receivedAt",
        "receivedBy",
        "vendorName"
      ],
      "properties": {
        "grnId": { "type": "string", "minLength": 1 },
        "poId": { "type": "string", "minLength": 1 },
        "itemName": { "type": "string", "minLength": 1 },
        "orderedQuantity": { "type": "number", "exclusiveMinimum": 0 },
        "acceptedQuantity": { "type": "number", "minimum": 0 },
        "rejectedQuantity": { "type": "number", "minimum": 0 },
        "unitOfMeasure": { "type": "string", "minLength": 1 },
        "rejectionReason": { "type": ["string", "null"] },
        "deliveryNoteNumber": { "type": ["string", "null"] },
        "deliveryDate": { "type": ["string", "null"], "format": "date-time" },
        "receivedAt": { "type": ["string", "null"], "format": "date-time" },
        "receivedBy": { "type": "string", "minLength": 1 },
        "vendorName": { "type": ["string", "null"] }
      }
    }
  }
}
