{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://procurement-platform/contracts/events/GOODS_RECEIVED.schema.json",
  "title": "GOODS_RECEIVED",
  "description": "Raised by inward-service on GRN — accepted quantity moves to Available Stock.",
  "allOf": [
    { "$ref": "_envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "GOODS_RECEIVED" },
        "payload": {
          "type": "object",
          "required": ["grnId", "poId", "itemId", "acceptedQuantity"],
          "properties": {
            "grnId": { "type": "string" },
            "poId": { "type": "string" },
            "itemId": { "type": "string" },
            "acceptedQuantity": { "type": "number" },
            "rejectedQuantity": { "type": "number" },
            "receivedBy": { "type": "string" },
            "invoiceDocumentKey": { "type": "string", "description": "S3 object key — never the binary document itself" }
          }
        }
      }
    }
  ]
}
