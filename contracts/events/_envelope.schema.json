{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://procurement-platform/contracts/events/_envelope.schema.json",
  "title": "Procurement Event Envelope",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "producer", "payload"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"type": "string"},
    "eventVersion": {"type": "integer", "minimum": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "producer": {"type": "string"},
    "correlationId": {"type": ["string", "null"]},
    "traceId": {"type": ["string", "null"]},
    "payload": {"type": "object"}
  }
}
