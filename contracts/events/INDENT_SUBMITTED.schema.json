{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://procurement-platform/contracts/events/INDENT_SUBMITTED.schema.json",
  "title": "INDENT_SUBMITTED",
  "description": "Raised when an employee submits a new indent for procurement.",
  "allOf": [
    { "$ref": "_envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "INDENT_SUBMITTED" },
        "payload": {
          "type": "object",
          "required": ["indentId", "departmentId", "projectId", "requestedBy", "items", "estimatedValue"],
          "properties": {
            "indentId": { "type": "string" },
            "departmentId": { "type": "string" },
            "projectId": { "type": "string" },
            "requestedBy": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["itemId", "quantity"],
                "properties": {
                  "itemId": { "type": "string" },
                  "quantity": { "type": "number" }
                }
              }
            },
            "estimatedValue": { "type": "number" }
          }
        }
      }
    }
  ]
}
