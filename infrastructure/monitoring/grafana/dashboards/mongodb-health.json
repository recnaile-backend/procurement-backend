{
  "title": "MongoDB Health",
  "uid": "mongodb-health",
  "tags": ["procurement-platform", "mongodb"],
  "panels": [
    { "type": "timeseries", "title": "Connection Pool Usage", "targets": [{ "expr": "mongodb_driver_pool_checkedout / mongodb_driver_pool_size" }] },
    { "type": "timeseries", "title": "Operation Latency", "targets": [{ "expr": "mongodb_operation_duration_seconds" }] },
    { "type": "timeseries", "title": "Errors / Timeouts", "targets": [{ "expr": "rate(mongodb_operation_errors_total[5m])" }, { "expr": "rate(mongodb_operation_timeouts_total[5m])" }] }
  ]
}
